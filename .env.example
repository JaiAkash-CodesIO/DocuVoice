# Server Configuration
PORT=8000
HOST=0.0.0.0
PYTHONUNBUFFERED=1

# Application Settings
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
SAMPLES_DIR=samples
MAX_FILE_SIZE_BYTES=10485760 # 10MB

# CORS Allowed Origins (Comma separated)
